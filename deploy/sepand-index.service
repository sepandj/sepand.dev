[Unit]
Description=sepand.dev index (visit chain + art)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=sepandidx
Group=sepandidx
WorkingDirectory=/opt/sepand-index
EnvironmentFile=/opt/sepand-index/.env
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/sepand-index/browsers
Environment=HOME=/var/cache/sepand-index
Environment=CACHE_DIR=/var/cache/sepand-index
CacheDirectory=sepand-index
ExecStart=/opt/sepand-index/venv/bin/uvicorn app:app --host 127.0.0.1 --port 8001 --workers 1 --proxy-headers
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
UMask=0077
MemoryMax=1G

[Install]
WantedBy=multi-user.target
